{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ESNext"],
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // Build config (vite/vitest/drizzle-kit) runs in Node, not workerd, and is
  // typechecked by the tools that execute it. Including it here would require
  // pulling Node/DOM libs into a Workers-scoped project.
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "*.config.ts"]
}
