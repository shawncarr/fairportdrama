{
  // Cloudflare Workers configuration for the Fairport Drama Club site.
  //
  // NOTE: this Worker deploys under its own name and workers.dev URL. The
  // fairportdrama.com custom domain stays on the existing `fairport-drama`
  // Worker until cutover.
  "name": "fairport-drama-next",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",
  "workers_dev": true,

  // Static assets: compiled CSS, favicon, and images not served by
  // Cloudflare Images. `npm run build:css` writes into public/static.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },

  // Same D1 instance as the current site. It holds live newsletter
  // subscribers; new tables are added by migration, never recreated.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fairport-drama-db",
      "database_id": "901d34db-5887-4721-aa26-ca8473b1bfe8",
      "migrations_dir": "drizzle",
    },
  ],

  // Sessions and the global cache version stamp.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3bb81e427a1643f29656d56254f3483d",
    },
  ],

  "images": {
    "binding": "IMAGES",
  },

  // Transactional email: contact form, invites, approval notices, and
  // newsletter opt-in confirmations.
  //
  // Restricted to a single sender address so a bug or compromise cannot send
  // as an arbitrary @fairportdrama.com address.
  //
  // Not marked `remote: true`, so local development does not send real mail.
  // Testing an actual delivery requires a deployed preview.
  //
  // NOTE: fairportdrama.com must be onboarded first:
  //   wrangler email sending enable fairportdrama.com
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@fairportdrama.com"],
    },
  ],

  "vars": {
    "SITE_URL": "https://fairportdrama.com",
    // Appears in every public image URL, so a var rather than a secret.
    // Required for delivery URLs, but it does not decide which store is used -
    // APP_ENV does. It is committed here, so keying selection on it sent
    // `wrangler dev` at the real Images account.
    "CF_IMAGES_ACCOUNT_HASH": "WkmTv5FeGiLo5ACVeQNYPw",
  },

  // Secrets, set via `wrangler secret put`:
  //   APP_ENV                 - set to `production` on the deployed Worker
  //                             only. Carried as a secret rather than a var
  //                             so `wrangler dev`, which cannot read deployed
  //                             secrets, sees it as absent and uses local
  //                             resources by default instead of by opting out.
  //   CONTACT_EMAIL           - contact form destination
  //   TURNSTILE_SECRET_KEY    - contact form spam check
  //   BETTER_AUTH_SECRET      - session signing
  //   GOOGLE_CLIENT_ID        - Google SSO
  //   GOOGLE_CLIENT_SECRET    - Google SSO
  //
  // Cloudflare Images needs no secret at runtime: uploads go through the
  // IMAGES binding. CF_IMAGES_ACCOUNT_ID and CF_IMAGES_API_TOKEN are needed
  // only by scripts/upload-images.mjs, which runs locally against the REST
  // API to seed the archive, and are read from .dev.vars there.
  //
  // Local development uses .dev.vars (gitignored).
}
